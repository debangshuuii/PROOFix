# PROOFix Environment Configuration

# Server
PORT=3000
NODE_ENV=development

# AI Provider API Keys (Optional - Deterministic Rule Diagnoser works offline without keys)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# GitHub Integration (Optional - for private repository import and check reports)
GITHUB_TOKEN=

# Sandbox Resource Policy
PROOFix_MAX_TIMEOUT_SECS=45
PROOFix_MEMORY_LIMIT_MB=1024
PROOFix_ALLOW_OUTBOUND_NETWORK=false
